import {
  "moonbit-community/verified/libs/bytes",
  "moonbit-community/verified/libs/mathint",
  "moonbit-community/verified/libs/seq",
}

import {
  "moonbitlang/core/debug",
} for "test"

// `seq` is only reached through `@bytes.model(...).length()` in the .mbtp
// proofs; the type checker calls it unused, but the Why3 lowering needs it.
warnings = "-unused_package"

options(
  "proof-enabled": true,
)
